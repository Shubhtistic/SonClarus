PROJECT_NAME="SonClarus"
PROJECT_VERSION="V1"
UPLOAD_URL_TTL_SECONDS=360 # presigned upload URL expiration
DOWNLOAD_URL_TTL_SECONDS=360 # presigned download URL and Redis cache expiration
ENVIRONMENT="test"


# --- PostgreSQL (Compose service name for containers) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=sonclarus_db

# --- Redis (Compose service name for containers) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_TLS=false

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_CLIENT_ID=sonclarus-backend
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_DENOISE_TOPIC=denoise
KAFKA_SEPARATE_TOPIC=separate
KAFKA_TRANSCRIBE_TOPIC=transcribe
KAFKA_SUMMARIZE_TOPIC=summarize
KAFKA_ML_RESULT_TOPIC=sonclarus-results
KAFKA_ML_RESULT_GROUP_ID=sonclarus-ml-results


# --- Security & JWT ---
JWT_SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_GRACE_PERIOD_MINUTES=5

# --- AWS Infrastructure (S3 & IAM) ---
AWS_ACCESS_KEY_ID=SONCLARUSKEY123
AWS_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=sonclarus1
# Local RustFS uses separate container and browser addresses. Leave both blank for AWS S3.
AWS_ENDPOINT_URL=http://rustfs:9000
AWS_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Machine Learning & API ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DOCS_ENDPOINT=anything-you-want

# --- Constraints ---
MAX_FILE_SIZE=52428800

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080", "https://sonclarus.shubhampawar.in"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600



# --- Bucket CORS bootstrap (non-live only) ---
# Optional. If omitted, ALLOWED_ORIGINS above is reused.
BUCKET_CORS_ORIGINS='["http://localhost:3000"]'
BUCKET_CORS_METHODS='["GET","HEAD","PUT","POST","DELETE"]'
BUCKET_CORS_HEADERS='["*"]'
BUCKET_CORS_EXPOSE_HEADERS='["ETag","Content-Disposition","x-amz-request-id"]'
BUCKET_CORS_MAX_AGE=3600
