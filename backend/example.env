PROJECT_NAME="SonClarus"
PROJECT_VERSION="V1"


# --- RDS PostgreSQL (Via SSH Tunnel) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=sonclarus_db

# --- ElastiCache Redis (Via SSH Tunnel) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_TLS=false

REDIS_URL=redis://localhost:6379/0


# --- Security & JWT ---
JWT_SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_GRACE_PERIOD_MINUTES=5

# --- AWS Infrastructure (S3 & IAM) ---
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-s3-bucket-name

# --- Machine Learning & API ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DOCS_ENDPOINT=anything-you-want

# --- Constraints ---
MAX_FILE_SIZE=52428800
S3_DOWNLOAD_LINK_EXPIRY_SECONDS=3600

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600
