# Copy to .env in the ml directory and set your deployment values.

# Kafka broker and topics (input names match backend configuration)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=sonclarus-backend
KAFKA_GROUP_ID_PREFIX=sonclarus-ml
KAFKA_DENOISE_TOPIC=denoise
KAFKA_SEPARATE_TOPIC=separate
KAFKA_TRANSCRIBE_TOPIC=transcribe
KAFKA_SUMMARIZE_TOPIC=summarize
KAFKA_ML_RESULT_TOPIC=sonclarus-results
KAFKA_START_MAX_ATTEMPTS=5
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_SEND_TIMEOUT_SECONDS=15
KAFKA_MAX_POLL_INTERVAL_MS=3600000

# Required only when KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# S3 credentials
AWS_ACCESS_KEY_ID=SONCLARUSKEY123
AWS_SECRET_ACCESS_KEY=replace-with-a-long-random-secret
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=sonclarus1
AWS_ENDPOINT_URL=http://localhost:9000

# Worker resource limits
ML_WORK_DIR=/tmp/sonclarus-ml
ML_TORCH_NUM_THREADS=2

# Summarization API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=120

# Denoise model
DF_MODEL_NAME=DeepFilterNet3
DF_POST_FILTER=true
# Optional: set to a number or a model directory path.
# DF_ATTEN_LIM_DB=6
# DF_MODEL_DIR=/path/to/model
DF_LOG_LEVEL=WARNING

# Separation model
SEPFORMER_SOURCE=speechbrain/sepformer-wsj02mix
SEPFORMER_SAVEDIR=pretrained_models/sepformer-wsj02mix
SEPFORMER_SAMPLE_RATE=8000
SEPARATOR_CHUNK_SAMPLES=120000
# Optional, defaults to CUDA when available, otherwise CPU.
# SEPARATOR_DEVICE=cpu

# Transcription model
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_VAD_MIN_SILENCE_MS=500
# Optional, defaults to CUDA when available, otherwise CPU.
# WHISPER_DEVICE=cpu
